# Source videos — never committed. Registered by path + hash in videos/<slug>/source.txt
*.mov
*.MOV
*.mp4
*.MP4
*.mkv
*.avi

# Regenerable frame sets. Only out/*/frames/kept/ is committed — see DEC-013.
out/*/frames/raw/
out/*/frames/rect/
out/*/frames/clean/
out/*/montages/

# Model response cache
.cache/

# Project profiles — the tool ships knowing no consuming project (DEC-017).
# _example.yaml is the committed template; real profiles stay local.
projects/*.yaml
!projects/_example.yaml

# Inventories imported from consuming projects — regenerate with their exporters
inventory.json
*.inventory.json

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
.idea/
.vscode/
